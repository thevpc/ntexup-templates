////////////////////
// classic theme (single file to simplify AI edition)
////////////////////

import(
    "common-functions"
    "plantuml"
    "animated-gif"
    "svg"
    "shapes2d"
    "shapes3d"
    "plot2d"
    "presenters"
    "latex"
)



////////////////////
// VARS
////////////////////

documentTitle:="My Document"
documentSubtitle:=""
documentSubsubtitle:=""
documentAuthor:="Author"
documentAuthorEmail:="author@example.com"
documentAuthorAffiliation:=""
documentChapter:=""
documentDate:=""
documentVersion:="1.0"

themeShowPalette:=false
documentColorAccent:=0
// Meridian — a refined noir palette with luminous accents
documentColors:=arrayLeftRotate([
    "#e5c158", // 0: Radiant champagne gold — primary accent
    "#60a5fa", // 1: Luminous azure blue
    "#34d399", // 2: Emerald mint green
    "#fbbf24", // 3: Warm amber gold
    "#f87171", // 4: Coral rose red
    "#a78bfa", // 5: Soft violet purple
    "#38bdf8", // 6: Cyan ice blue
    "#fb923c", // 7: Vibrant orange
    "#e879f9", // 8: Orchid pink
    "#4ade80", // 9: Bright spring lime
    "#94a3b8", // 10: Slate silver
    "#fef08a"  // 11: Light canary highlight
], either(documentColorAccent, 0))

// Core neutrals — the Meridian noir surface system (kept outside the rotating accent array
// so the look stays stable even if documentColorAccent is changed)
documentBg:="#0d0f13"            // page background — near-black charcoal
documentSurface:="#161920"       // raised panel / card surface
documentSurfaceAlt:="#1d212a"    // secondary panel surface
documentLine:="#2a2e38"          // hairline dividers / borders
documentTextPrimary:="#f2f0ea"   // primary text — warm ivory
documentTextSecondary:="#a7abb8" // secondary text — cool grey
documentTextMuted:="#666b78"     // muted / tertiary text

// Fixed semantic colors for callouts (independent from the rotating accent)
semanticInfoColor:="#6b8caf"
semanticInfoBg:="#131922"
semanticWarningColor:="#c9974a"
semanticWarningBg:="#1c160e"
semanticErrorColor:="#b5654f"
semanticErrorBg:="#1e1310"
semanticSuccessColor:="#7c9885"
semanticSuccessBg:="#121a15"


////////////////////
// STYLES
////////////////////

styles{
    all{
        font-size : 4.5%P
        font-family : "SansSerif",
        color: documentTextPrimary
    }

    source{
        font-size : 1.85%P,
        font-family : "monospaced",
        source-primary-color: documentTextPrimary
        source-keyword-color: documentColors[0]
        source-separator-color: documentTextSecondary
        source-string-color: "#a8c98a"
        source-comments-color: documentTextMuted
        source-number-color: documentColors[5]
        source-keyword-font-bold
        background-color: "#0a0c10"
        color: documentTextPrimary
        draw-contour: true
        padding: (0.8%P, 0.4%P)
    }

    page{
        background-color: documentBg
    }

    text{
        text-wrap: wrap
    }

    class-ul-item{
        margin : (1.8, 0)
        at: left,
        font-size: 3.2%P
        text-wrap: wrap
    }
    class-ul-bullet{
        background-color: documentColors[0]
        at: left,
        size: 1.6%P
    }
    class-ol-bullet{
        color: documentColors[0]
        at: center,
        font-bold
    }
    class-ol-item{
        at: left,
        margin: (1.8, 0)
        font-size: 3.2%P
        text-wrap: wrap
    }
    class-compact{
        font-size: 2.3%P
    }
    class-compact-list{
        font-size: 2.3%P
    }
    class-large{
        font-size: 3.4%P
    }
    ellipse{
        at: center,
    }
    arc{
        at: center,
    }

    class-image-fig{
        margin: 2
    }
    class-image-fig-legend{
        at: bottom
        font-size: 2.5%P
        color: documentTextMuted
    }
    class-image-fig-title{
        at: top
        font-size: 3.2%P
        font-bold,
        color: documentColors[0]
    }

    // Shape primitives — default to centered placement, matching ellipse/arc above,
    // so a bare shape() call behaves consistently across the whole showcase.
    triangle{ at: center }
    square{ at: center }
    circle{ at: center }
    rhombus{ at: center }
    diamond{ at: center }
    parallelogram{ at: center }
    trapezoid{ at: center }
    pentagon{ at: center }
    hexagon{ at: center }
    heptagon{ at: center }
    octagon{ at: center }
    nonagon{ at: center }
    decagon{ at: center }
    polygon{ at: center }
    donut{ at: center }
    pie{ at: center }
    cylinder{ at: center }

    // Grid hairlines follow the theme's own dividers instead of a default black grid
    grid{
        line-color: documentLine
    }

    // Inline LaTeX equations and NTF rich-text inherit the theme's ivory foreground
    eq{
        color: documentTextPrimary
    }
    ntf{
        color: documentTextPrimary
    }
}

////////////////////
// COMPONENTS
////////////////////

@define image-fig(src, title:"", legend:"", at:center, size:30){
    @(img) group(at: at, size: size){
        rectangle(background-color: documentSurface, color: documentLine, draw-contour: true, round-corner: 3)
        @(image-fig) image(src, size: (92, 80), at: center, preserve-aspect-ratio)
        @(image-fig-title) text("${title}")
        @(image-fig-legend) text("${legend}")
    }
}

@define card(accentColor: ""){
    group(margin: 1, row-weight: 70){
        rectangle(background-color: documentSurface, color: documentLine, draw-contour: true, round-corner: 4)
        rectangle(background-color: either(accentColor, documentColors[0]), position: (0, 6), size: (0.35%P, 88))
        @define kicker(text, color: ""){
            group(position: (4, 3), size: (92, 8), origin: top-left){
                rectangle(position: (0, 50), size: (1.2%P, 0.35%P), origin: left, background-color: either(color, either(accentColor, documentColors[0])))
                text("${text}", position: (1.8%P, 50), origin: left, font-size: 2.2%P, font-bold, color: either(color, either(accentColor, documentColors[0])))
            }
        }
        styles{
            unordered-list{
                position: (4, 12)
                size: (92, 86)
                origin: top-left
            }
            ul{
                position: (4, 12)
                size: (92, 86)
                origin: top-left
            }
            ordered-list{
                position: (4, 12)
                size: (92, 86)
                origin: top-left
            }
            ol{
                position: (4, 12)
                size: (92, 86)
                origin: top-left
            }
            column{
                position: (4, 12)
                size: (92, 86)
                origin: top-left
            }
            col{
                position: (4, 12)
                size: (92, 86)
                origin: top-left
            }
            source{
                position: (4, 12)
                size: (92, 86)
                origin: top-left
                font-size: 1.85%P
            }
            class-ul-item{
                font-size: 2.3%P
                margin: (1.2, 0)
                text-wrap: wrap
            }
            class-ol-item{
                font-size: 2.3%P
                margin: (1.2, 0)
                text-wrap: wrap
            }
            class-ul-bullet{
                size: 1.3%P
            }
        }
        slot
    }
}

@define kicker(text, color: ""){
    group(size: (100, 6)){
        rectangle(position: (0, 50), size: (1.2%P, 0.35%P), origin: left, background-color: either(color, documentColors[0]))
        text("${text}", position: (1.8%P, 50), origin: left, font-size: 2.2%P, font-bold, color: either(color, documentColors[0]))
    }
}

@define divider(width: 40, thickness: 0.3){
    rectangle(size: (width, thickness), background-color: documentColors[0])
}

@define stat(value, label){
    group(margin: 1){
        text("${value}", position: (50, 38), origin: center, font-size: 7.5%P, font-bold, color: documentColors[0])
        text("${label}", position: (50, 68), origin: center, font-size: 2.8%P, color: documentTextSecondary)
    }
}

@define quote(author: ""){
    group(margin: 3){
        rectangle(background-color: documentColors[0], position: (0, 4), size: (0.35%P, 92))
        group(position: (5, 4), size: (93, 92)){
            slot
            text(either("${author}", ""), position: (0, 92), font-size: 3%P, color: documentTextSecondary, font-bold)
        }
    }
}

// Light "paper" surface for content that needs its own bright canvas on the dark
// page — UML, Gantt, network diagrams, plots, and wireframes are generated by
// external renderers and read best on a light background. Use this instead of a
// plain white miniPage so they stay on-brand with a warm ivory tone, a hairline
// border and a soft drop shadow rather than a stark white box.
@define panel(background: ""){
    group(margin: 2){
        rectangle(
            background-color: either(background, "#f5f4f0"),
            color: documentLine,
            draw-contour: true,
            round-corner: 6,
            shadow: {distance: (0, 2), radius: 6, color: "#000000"}
        )
        group(position: (3, 3), size: (94, 94)){
            slot
        }
    }
}

@define callout(title, accentColor, bgColor){
    group(margin: 1, row-weight: 30){
        rectangle(background-color: bgColor, color: documentLine, draw-contour: true, round-corner: 4)
        rectangle(background-color: accentColor, position: (0, 0), size: (1.5, 100))
        group(position: (4, 4), size: (92, 92), origin: top-left){
            text(either("${title}", ""), position: (0, 0), origin: top-left, font-bold, color: accentColor, font-size: 2.2%P)
            group(position: (0, 30), size: (100, 68), origin: top-left){
                styles{
                    all{
                        font-size: 2.0%P
                    }
                }
                slot
            }
        }
    }
}

@define hint-info(title){
    callout(title: either("${title}", "Information"), accentColor: semanticInfoColor, bgColor: semanticInfoBg){
        slot
    }
}

@define hint-warning(title){
    callout(title: either("${title}", "Warning"), accentColor: semanticWarningColor, bgColor: semanticWarningBg){
        slot
    }
}

@define hint-error(title){
    callout(title: either("${title}", "Important"), accentColor: semanticErrorColor, bgColor: semanticErrorBg){
        slot
    }
}

@define hint-success(title){
    callout(title: either("${title}", "Note"), accentColor: semanticSuccessColor, bgColor: semanticSuccessBg){
        slot
    }
}

////////////////////
// COVER SLIDE
////////////////////

@define cover-slide(){
    page{
        styles{
            class-kicker{
                color: documentColors[0],
                origin: left,
                position: (8, 18),
                font-size: 2.8%P,
                font-family: "SansSerif",
                font-bold
            }
            class-title{
                color: documentTextPrimary,
                origin: left,
                position: (8, 32),
                font-size: 7.5%P,
                font-family: "SansSerif",
                font-bold
            }
            class-subtitle{
                color: documentColors[0],
                origin: left,
                position: (8, 44),
                font-size: 3.8%P,
                font-family: "SansSerif",
                font-bold
            }
            class-subsubtitle{
                color: documentTextSecondary,
                origin: left,
                position: (8, 50),
                font-size: 3%P,
                font-family: "SansSerif"
            }
            class-author{
                color: documentTextPrimary,
                origin: left,
                position: (8, 84),
                font-size: 3.4%P,
                font-bold
            }
            class-affiliation{
                color: documentTextSecondary,
                origin: left,
                position: (8, 88.5),
                font-size: 2.8%P
            }
            class-email{
                color: documentColors[0],
                origin: left,
                position: (8, 92.5),
                font-size: 2.6%P
            }
            class-date{
                color: documentTextMuted,
                origin: right,
                position: (92, 8),
                font-size: 2.4%P
            }
            class-version{
                color: documentTextMuted,
                origin: right,
                position: (92, 92.5),
                font-size: 2.2%P
            }
        }

        // Noir background
        rectangle(background-color: documentBg)

        // Editorial corner marks (top-left, bottom-right)
        rectangle(position: (6, 6), size: (5, 0.2), background-color: documentColors[0])
        rectangle(position: (6, 6), size: (0.2, 5), background-color: documentColors[0])
        rectangle(position: (89, 94), size: (5, 0.2), background-color: documentColors[0])
        rectangle(position: (94, 89), size: (0.2, 5), background-color: documentColors[0])

        // Accent rule under subtitle block
        rectangle(position: (8, 58), size: (12, 0.3), background-color: documentColors[0])

        @(kicker)      text(either("${documentChapter}", "Presentation"))
        @(title)       text("${documentTitle}")
        @(subtitle)    text(either("${documentSubtitle}", ""))
        @(subsubtitle) text(either("${documentSubsubtitle}", ""))
        @(author)      text(either("${documentAuthor}", ""))
        @(affiliation) text(either("${documentAuthorAffiliation}", ""))
        @(email)       text(either("${documentAuthorEmail}", ""))
        @(date)        text(either("${documentDate}", ""))
        @(version)     text(either("${documentVersion}", ""))
        slot
    }
}

////////////////////
// AGENDA SLIDE
////////////////////

@define agenda-slide(title){
    content-slide(title: either("${title}", "Agenda")){
        styles{
            class-ul-item{
                margin: (2.8, 0)
                font-size: 3.4%P
                text-wrap: wrap
            }
            class-ol-item{
                margin: (2.8, 0)
                font-size: 3.4%P
                text-wrap: wrap
            }
            class-ul-bullet{
                size: 1.8%P
            }
            class-ol-bullet{
                font-size: 3.4%P
            }
        }
        slot
    }
}

////////////////////
// CONTENT SLIDE
////////////////////

@define content-slide(title){
    page{
        rectangle(background-color: documentBg)

        @define header{
            group(
                position: (0, 0),
                size: (100, 16),
                origin: top-left
            ){
                // Accent tick + chapter kicker
                rectangle(position: (3, 30), size: (2.2, 2.5), background-color: documentColors[0])
                text(
                    either("${documentChapter}", "${documentTitle}"),
                    position: (6.5, 32),
                    origin: left,
                    font-size: 2.6%P,
                    font-bold,
                    color: documentColors[0]
                )

                // Slide title
                text(
                    "${title}",
                    position: (3, 62),
                    origin: left,
                    font-size: 5%P,
                    font-bold,
                    color: documentTextPrimary
                )

                // header hairline
                rectangle(
                    position: (0, 98),
                    size: (100, 0.15),
                    background-color: documentLine
                )

                slot
            }
        }

        @define footer{
            group(
                position: (0, 96),
                size: (100, 4),
                origin: top-left
            ){
                text(
                    "${documentTitle}",
                    position: (3, 50),
                    origin: left,
                    font-size: 2.2%P,
                    color: documentTextMuted
                )
                text(
                    either("${documentDate}", ""),
                    position: (97, 50),
                    origin: right,
                    font-size: 2.2%P,
                    color: documentTextMuted
                )
            }
        }

        @define body{
            group(
                position: (3, 20),
                size: (94, 74),
                origin: top-left,
                font-size: 3.2%P,
                color: documentTextPrimary
            ){
                slot
            }
        }

        @define body2a{
            col(
                position: (3, 20),
                size: (45, 74),
                origin: top-left,
                font-size: 2.8%P,
                color: documentTextPrimary
            ){
                styles{
                    class-ul-item{
                        font-size: 2.6%P
                        margin: (1.4, 0)
                        text-wrap: wrap
                    }
                    class-ol-item{
                        font-size: 2.6%P
                        margin: (1.4, 0)
                        text-wrap: wrap
                    }
                    class-ul-bullet{
                        size: 1.4%P
                    }
                }
                slot
            }
        }

        @define body2b{
            col(
                position: (52, 20),
                size: (45, 74),
                origin: top-left,
                font-size: 2.8%P,
                color: documentTextPrimary
            ){
                styles{
                    class-ul-item{
                        font-size: 2.6%P
                        margin: (1.4, 0)
                        text-wrap: wrap
                    }
                    class-ol-item{
                        font-size: 2.6%P
                        margin: (1.4, 0)
                        text-wrap: wrap
                    }
                    class-ul-bullet{
                        size: 1.4%P
                    }
                }
                slot
            }
        }

        @define body3a{
            col(
                position: (3, 20),
                size: (29, 74),
                origin: top-left,
                font-size: 2.4%P,
                color: documentTextPrimary
            ){
                styles{
                    class-ul-item{
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    class-ol-item{
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    class-ul-bullet{
                        size: 1.2%P
                    }
                }
                slot
            }
        }

        @define body3b{
            col(
                position: (35, 20),
                size: (29, 74),
                origin: top-left,
                font-size: 2.4%P,
                color: documentTextPrimary
            ){
                styles{
                    class-ul-item{
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    class-ol-item{
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    class-ul-bullet{
                        size: 1.2%P
                    }
                }
                slot
            }
        }

        @define body3c{
            col(
                position: (67, 20),
                size: (29, 74),
                origin: top-left,
                font-size: 2.4%P,
                color: documentTextPrimary
            ){
                styles{
                    class-ul-item{
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    class-ol-item{
                        font-size: 2.2%P
                        margin: (1.2, 0)
                        text-wrap: wrap
                    }
                    class-ul-bullet{
                        size: 1.2%P
                    }
                }
                slot
            }
        }

        header()
        slot
        footer()
    }
}

////////////////////
// CONCLUSION SLIDE
////////////////////

@define conclusion-slide(title){
    content-slide(title: either("${title}", "Conclusion")){
        slot
    }
}

////////////////////
// THANK YOU SLIDE
////////////////////

@define thankyou-slide(title:""){
    page{
        rectangle(background-color: documentBg)

        styles{
            class-kicker{
                color: documentColors[0],
                origin: left,
                position: (8, 26),
                font-size: 2.8%P,
                font-family: "SansSerif",
                font-bold
            }
            class-thankyou-title{
                color: documentTextPrimary,
                origin: left,
                position: (8, 40),
                font-size: 8.5%P,
                font-family: "SansSerif",
                font-bold
            }
            class-thankyou-subtitle{
                color: documentColors[0],
                origin: left,
                position: (8, 52),
                font-size: 4%P,
                font-family: "SansSerif",
                font-bold
            }
            class-thankyou-author{
                color: documentTextPrimary,
                origin: left,
                position: (8, 74),
                font-size: 3.4%P,
                font-family: "SansSerif",
                font-bold
            }
            class-thankyou-email{
                color: documentColors[0],
                origin: left,
                position: (8, 78.5),
                font-size: 2.8%P,
                font-family: "SansSerif"
            }
        }

        // Editorial corner marks, mirrored from the cover
        rectangle(position: (6, 6), size: (5, 0.2), background-color: documentColors[0])
        rectangle(position: (6, 6), size: (0.2, 5), background-color: documentColors[0])
        rectangle(position: (89, 94), size: (5, 0.2), background-color: documentColors[0])
        rectangle(position: (94, 89), size: (0.2, 5), background-color: documentColors[0])

        // Accent rule
        rectangle(position: (8, 60), size: (12, 0.3), background-color: documentColors[0])

        @(kicker)            text("Thank You")
        @(thankyou-title)    text(either("${title}", "Questions?"))
        @(thankyou-subtitle) text("Let's discuss")
        @(thankyou-author)   text(either("${documentAuthor}", ""))
        @(thankyou-email)    text(either("${documentAuthorEmail}", ""))
        slot
    }
}
