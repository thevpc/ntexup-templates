////////////////////
// classic theme — light, sophisticated, modern (the recommended default)
// (single file to simplify AI edition)
//
// Warm paper background, ink-coloured cover panel with soft geometric accents,
// accent-tab cards with a hairline border and a faint shadow, and one page grid
// shared by every slide:
//   margins x 6..94 · header 4..17 · body 19..91 · footer 95.5
////////////////////

import(
    "stdlib"
    "layout"
    "image"
    "text"
    "plantuml"
    "animated-gif"
    "svg"
    "shapes2d"
    "shapes3d"
    "plot2d"
    "scoreboard"
    "table"
    "presenters"
    "latex"
)

////////////////////
// VARS
////////////////////

documentTitle:="My Document"
documentSubtitle:=""
documentSubsubtitle:=""
documentAuthor:="Author"
documentAuthorEmail:="author@example.com"
documentAuthorAffiliation:=""
documentChapter:=""
documentDate:=""
documentVersion:="1.0"

themeShowPalette:=false
documentColorAccent:=0

// Jewel-tone palette, tuned for >= 4.5:1 on the paper background
documentColors:=arrayLeftRotate([
    "#4338ca", // 0: indigo (primary)
    "#0e7490", // 1: deep cyan
    "#b45309", // 2: amber
    "#be185d", // 3: raspberry
    "#047857", // 4: emerald
    "#6d28d9", // 5: violet
    "#1d4ed8", // 6: royal blue
    "#a16207", // 7: ochre
    "#9f1239", // 8: crimson
    "#0f766e", // 9: teal
    "#c2410c", // 10: burnt orange
    "#1e293b"  // 11: slate
], either(documentColorAccent, 0))

// Surfaces & text
documentBg:="#fafaf7"            // warm paper
documentSurface:="#ffffff"       // cards
documentSurfaceAlt:="#f3f2ed"    // secondary panels
documentLine:="#e4e2da"          // hairlines
documentTextPrimary:="#14161c"   // ink
documentTextSecondary:="#4b5162" // secondary text
documentTextMuted:="#6b7080"     // captions, footer (4.6:1)
documentPrimaryColor:=documentColors[0]

// Chrome (cover / section / closing panels)
themeInk:="#12141c"
themeOnInk:="#f5f3ee"
themeOnInkMuted:="#a3a7b6"
themeTitleFont:="SansSerif"
themeBodyFont:="SansSerif"
themeCardShadow:="#1418281a"
themeArtA:="#4338ca55"
themeArtB:="#0e749066"
themeArtC:="#b4530977"
themeCodeBg:="#141824"
themeCodeLine:="#262c3d"

// Semantic colors (callouts)
semanticInfoColor:="#0e7490"
semanticInfoBg:="#eef8fa"
semanticWarningColor:="#92400e"
semanticWarningBg:="#fdf6e9"
semanticErrorColor:="#b91c1c"
semanticErrorBg:="#fdf0f0"
semanticSuccessColor:="#15803d"
semanticSuccessBg:="#eef8f1"

////////////////////
// STYLES
////////////////////

styles{
    (*){
        font-size : 3.4%P
        font-family : themeBodyFont,
        color: documentTextPrimary
    }

    source{
        font-size : 2.3%P,
        font-family : "monospaced",
        source-primary-color: "#e8eaf2"
        source-keyword-color: "#8ab4ff"
        source-entity-color: "#7dd3fc"
        source-action-color: "#a5b4fc"
        source-annotation-color: "#fda4af"
        source-variable-color: "#f9a8d4"
        source-operator-color: "#e8eaf2"
        source-separator-color: "#9aa3b8"
        source-comments-color: "#7c859c"
        source-string-color: "#b5e08a"
        source-input-color: "#fde68a"
        source-path-color: "#7dd3fc"
        source-version-color: "#fbbf77"
        source-number-color: "#fbbf77"
        source-date-color: "#fbbf77"
        source-boolean-color: "#fbbf77"
        source-option-color: "#c4b5fd"
        source-title-color: "#e8eaf2"
        source-error-color: "#f87171"
        source-keyword-font-bold
        background-color: themeCodeBg
        color: "#e8eaf2"
        line-color: themeCodeLine
        draw-contour: true
        padding: (1%P, 0.6%P)
    }

    page{
        background-color: documentBg
    }

    text{
        text-wrap: wrap
        source-code-font-family: "monospaced"
        source-primary-color: "#14161c"
        source-keyword-color: "#3730a3"
        source-entity-color: "#4338ca"
        source-action-color: "#0e7490"
        source-annotation-color: "#be123c"
        source-variable-color: "#9f1239"
        source-operator-color: "#14161c"
        source-separator-color: "#6b7080"
        source-comments-color: "#6b7080"
        source-string-color: "#166534"
        source-input-color: "#a16207"
        source-path-color: "#0e7490"
        source-version-color: "#b45309"
        source-number-color: "#b45309"
        source-date-color: "#b45309"
        source-boolean-color: "#6d28d9"
        source-option-color: "#4338ca"
        source-title-color: "#14161c"
        source-error-color: "#b91c1c"
    }
    ellipse{
        at: center,
    }
    arc{
        at: center,
    }

    @ul-item{
        margin : (1.2, 0)
        at: left,
        font-size: 3.2%P
        text-wrap: wrap
    }
    @ul-item-2{
        font-size: 2.8%P
        color: documentTextSecondary
    }
    @ul-bullet{
        background-color: documentColors[0]
        at: left,
        size: 1.1%P
    }
    @ul-bullet-2{
        background-color: documentTextMuted
        size: 0.9%P
    }
    @ol-bullet{
        color: documentColors[0]
        at: center,
        font-bold
    }
    @ol-item{
        at: left,
        margin: (1.2, 0)
        font-size: 3.2%P
        text-wrap: wrap
    }
    @compact{
        font-size: 2%P
    }
    @compact-list{
        font-size: 2%P
    }
    @large{
        font-size: 3.4%P
    }
    @lead{
        font-size: 3.2%P
        color: documentTextSecondary
    }
    @muted{
        color: documentTextMuted
    }
    @accent{
        color: documentColors[0]
        font-bold
    }
    @image-fig{
        margin: 2
    }
    @image-fig-title{
        at: top
        font-size: 2%P
        font-bold,
        color: documentTextPrimary
    }
    @image-fig-legend{
        at: bottom
        font-size: 1.6%P
        color: documentTextMuted
    }
    grid{
        line-color: documentLine
    }
    eq{
        color: documentTextPrimary
    }
    ntf{
        color: documentTextPrimary
    }

    table{
        font-size: 2.4%P
        color: documentTextPrimary
        background-color: documentSurface
        draw-grid
        line-color: documentLine
        padding: (0.8%P, 0.4%P)
    }
    table-header{
        font-size: 2.4%P
        font-bold
        color: "#ffffff"
        background-color: documentColors[0]
    }
    table-footer{
        font-size: 2.2%P
        font-bold
        color: documentTextSecondary
        background-color: documentSurfaceAlt
    }
    table-row(row: even): {
        background-color: documentBg
    }
    table-cell{
        padding: (0.8%P, 0.4%P)
    }

    @table-striped{
        background-color: documentSurface
        row(row: even){
            background-color: documentSurfaceAlt
        }
        table-header{
            font-bold
            color: "#ffffff"
            background-color: documentColors[0]
        }
        cell{ padding: (0.8%P, 0.4%P) }
    }

    @table-bordered{
        background-color: documentSurface
        draw-grid
        line-color: documentLine
        row{
            background-color: documentSurface
            color: documentTextPrimary
        }
        table-header{
            font-bold
            color: documentTextPrimary
            background-color: documentSurfaceAlt
        }
        cell{ padding: (0.8%P, 0.4%P) }
    }
}

////////////////////
// COMPONENTS
////////////////////

@define image-fig(src, title:"", legend:"", at:center, size:30){
    @(img) group(at: at, size: size){
        rectangle(background-color: documentSurface, line-color: documentLine, draw-contour, size: 98, round-corner: 2)
        @(image-fig) image(src, size: (92, 80), at: center, preserve-aspect-ratio)
        @(image-fig-title) text("${title}")
        @(image-fig-legend) text("${legend}")
    }
}

// Card: white surface, hairline border, faint shadow and an accent tab on top.
@define card(accentColor: ""){
    group(margin: 1, row-weight: 70){
        rectangle(
            background-color: documentSurface,
            line-color: documentLine,
            draw-contour: true,
            round-corner: 2,
            shadow: {distance: (0, 1), radius: 4, color: themeCardShadow}
        )
        rectangle(background-color: either(accentColor, documentColors[0]), position: (4, 0), origin: top-left, size: (16, 0.45%P))
        @define kicker(text, color: ""){
            group(position: (4, 5), size: (92, 7), origin: top-left){
                text("${text}", position: (0, 50), origin: left, font-size: 1.9%P, font-bold, color: either(color, either(accentColor, documentColors[0])))
            }
        }
        styles{
            unordered-list{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            ul{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            ordered-list{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            ol{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            column{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            col{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            source{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
                font-size: 2.1%P
            }
            @ul-item{
                font-size: 2.5%P
                margin: (0.8, 0)
                text-wrap: wrap
            }
            @ol-item{
                font-size: 2.5%P
                margin: (0.8, 0)
                text-wrap: wrap
            }
            @ul-bullet{
                size: 0.9%P
                background-color: either(accentColor, documentColors[0])
            }
        }
        slot
    }
}

// Small uppercase label preceded by an accent dash.
@define kicker(text, color: ""){
    group(size: (100, 6)){
        rectangle(position: (0, 50), size: (1.4%P, 0.3%P), origin: left, background-color: either(color, documentColors[0]))
        text("${text}", position: (2.2%P, 50), origin: left, font-size: 2%P, font-bold, color: either(color, documentColors[0]))
    }
}

@define divider(width: 40, thickness: 0.3){
    rectangle(size: (width, thickness), background-color: documentColors[0])
}

@define stat(value, label, accentColor: ""){
    group(margin: 1){
        text("${value}", position: (50, 40), origin: center, font-size: 7%P, font-bold, font-family: themeTitleFont, color: either(accentColor, documentColors[0]))
        rectangle(position: (50, 60), origin: center, size: (12, 0.25%P), background-color: documentLine)
        text("${label}", position: (50, 72), origin: center, font-size: 2.2%P, color: documentTextSecondary)
    }
}

@define quote(author: ""){
    group(margin: 3){
        text("“", position: (0, 0), origin: top-left, font-size: 7%P, font-family: "Serif", font-bold, color: documentColors[0])
        group(position: (2, 16), size: (96, 78)){
            slot
            text(either("${author}", ""), position: (0, 94), font-size: 1.8%P, color: documentTextSecondary, font-bold)
        }
    }
}

@define panel(background: "", title:"", accentColor){
    group(margin: 2){
        rectangle(
            background-color: either(background, documentSurface),
            line-color: documentLine,
            draw-contour: true,
            round-corner: 2,
            shadow: {distance: (0, 1), radius: 4, color: themeCardShadow}
        )
        group(position: (4, 8), size: (92, 88)){
            text(
                either("${title}", ""),
                font-size: 2.8%P,
                font-bold,
                position: (0, 0),
                origin: top-left,
                color: either(accentColor, documentColors[0])
            )
            group(position: (0, 14), size: (100, 86)){
                slot
            }
        }
    }
}

@define callout(title: "", accentColor, bgColor){
    group(margin: 1, row-weight: 30){
        rectangle(background-color: bgColor, line-color: documentLine, draw-contour: true, round-corner: 2)
        rectangle(background-color: accentColor, position: (0, 50), origin: left, size: (0.45%P, 84))
        group(position: (5, 8), size: (90, 86), origin: top-left){
            text(either("${title}", ""), position: (0, 0), origin: top-left, font-bold, color: accentColor, font-size: 2.4%P)
            group(position: (0, 20), size: (100, 80), origin: top-left){
                styles{
                    (*){
                        font-size: 2.3%P
                        color: documentTextPrimary
                    }
                }
                slot
            }
        }
    }
}

@define hint-info(title){
    callout(title: either("${title}", "Information"), accentColor: semanticInfoColor, bgColor: semanticInfoBg){
        slot
    }
}

@define hint-warning(title){
    callout(title: either("${title}", "Warning"), accentColor: semanticWarningColor, bgColor: semanticWarningBg){
        slot
    }
}

@define hint-error(title){
    callout(title: either("${title}", "Important"), accentColor: semanticErrorColor, bgColor: semanticErrorBg){
        slot
    }
}

@define hint-success(title){
    callout(title: either("${title}", "Note"), accentColor: semanticSuccessColor, bgColor: semanticSuccessBg){
        slot
    }
}

@define definition(title){
    callout(title: either("${title}", "Definition"), accentColor: semanticInfoColor, bgColor: semanticInfoBg){
        slot
    }
}

@define theorem(title){
    callout(title: either("${title}", "Theorem"), accentColor: documentColors[0], bgColor: documentSurfaceAlt){
        slot
    }
}

@define example(title){
    callout(title: either("${title}", "Example"), accentColor: semanticSuccessColor, bgColor: semanticSuccessBg){
        slot
    }
}

@define remark(title){
    callout(title: either("${title}", "Remark"), accentColor: semanticWarningColor, bgColor: semanticWarningBg){
        slot
    }
}

// Footer: document identity left, date right, on the shared page grid.
@define footer(){
    text("${documentTitle}", position: (6, 95.6), origin: left, font-size: 1.8%P, font-bold, color: documentTextMuted)
    text(either("${documentDate}", ""), position: (94, 95.6), origin: right, font-size: 1.8%P, color: documentTextMuted)
}

// The ink panel art shared by cover, section and closing slides.
@define classic-art(){
    rectangle(position: (64, 0), size: (36, 100), origin: top-left, background-color: themeInk)
    circle(position: (84, 34), size: (40, 40), origin: center, background-color: themeArtA)
    circle(position: (90, 58), size: (24, 24), origin: center, background-color: themeArtB)
    circle(position: (74, 70), size: (9, 9), origin: center, background-color: themeArtC)
    rectangle(position: (68, 84), size: (28, 0.15), origin: top-left, background-color: "#ffffff26")
    rectangle(position: (64, 0), size: (0.5, 100), origin: top-left, background-color: documentColors[0])
}

////////////////////
// COVER SLIDE
////////////////////

@define cover-slide(){
    page{
        rectangle(background-color: documentBg)
        classic-art()

        rectangle(position: (7, 16), size: (2.2, 0.5), origin: left, background-color: documentColors[0])
        text(either("${documentChapter}", "Presentation"), position: (10.2, 16), origin: left, font-size: 2.3%P, font-bold, color: documentColors[0])

        text("${documentTitle}", position: (7, 31), origin: left, font-size: 9%P, font-bold, font-family: themeTitleFont, color: documentTextPrimary)
        text(either("${documentSubtitle}", ""), position: (7, 43), origin: left, font-size: 3.8%P, color: documentTextSecondary)
        text(either("${documentSubsubtitle}", ""), position: (7, 49.5), origin: left, font-size: 2.7%P, color: documentTextMuted)

        rectangle(position: (7, 62), size: (50, 0.15), origin: left, background-color: documentLine)

        text(either("${documentAuthor}", ""), position: (7, 70), origin: left, font-size: 3.2%P, font-bold, color: documentTextPrimary)
        text(either("${documentAuthorAffiliation}", ""), position: (7, 75.5), origin: left, font-size: 2.5%P, color: documentTextSecondary)
        text(either("${documentAuthorEmail}", ""), position: (7, 80.5), origin: left, font-size: 2.5%P, color: documentColors[0])

        text(either("${documentDate}", ""), position: (68, 91), origin: left, font-size: 2.2%P, color: themeOnInkMuted)
        text(either("${documentVersion}", ""), position: (96, 91), origin: right, font-size: 2.2%P, font-bold, color: themeOnInk)
        slot
    }
}

////////////////////
// SECTION SLIDE (bonus: chapter openers)
////////////////////

@define section-slide(title, number:"", subtitle:""){
    page{
        rectangle(background-color: themeInk)
        circle(position: (86, 30), size: (56, 56), origin: center, background-color: themeArtA)
        circle(position: (94, 70), size: (30, 30), origin: center, background-color: themeArtB)
        text("${number}", position: (8, 34), origin: left, font-size: 12%P, font-bold, font-family: themeTitleFont, color: documentColors[0])
        rectangle(position: (8, 50), size: (8, 0.5), origin: left, background-color: documentColors[0])
        text("${title}", position: (8, 60), origin: left, font-size: 6%P, font-bold, font-family: themeTitleFont, color: themeOnInk)
        text("${subtitle}", position: (8, 69), origin: left, font-size: 2.6%P, color: themeOnInkMuted)
        text("${documentTitle}", position: (8, 95.6), origin: left, font-size: 1.8%P, font-bold, color: themeOnInkMuted)
        slot
    }
}

////////////////////
// AGENDA SLIDE
////////////////////
@define agenda-slide(title:""){
    content-slide(title: either("${title}", "Agenda")){
        styles{
            @ul-item{
                margin: (2.4, 0)
                font-size: 3.8%P
                text-wrap: wrap
            }
            @ol-item{
                margin: (2.4, 0)
                font-size: 3.8%P
                text-wrap: wrap
            }
            @ol-bullet{
                font-size: 3.8%P
                color: documentColors[0]
            }
        }
        slot
    }
}

////////////////////
// CONTENT SLIDE
////////////////////

@default-body(body, body2a, body2b, body3a, body3b, body3c)
@define content-slide(title, section:""){
    page{
        rectangle(background-color: documentBg)
        // left accent spine
        rectangle(position: (0, 0), size: (0.5, 100), origin: top-left, background-color: documentColors[0])

        @define header{
            group(position: (0, 0), size: (100, 100), origin: top-left){
                rectangle(position: (6, 6), size: (1.8, 0.45), origin: left, background-color: documentColors[0])
                text(
                    either("${section}", either("${documentChapter}", "${documentTitle}")),
                    position: (8.6, 6),
                    origin: left,
                    font-size: 2%P,
                    font-bold,
                    color: documentColors[0]
                )
                text(
                    "${title}",
                    position: (6, 11.4),
                    origin: left,
                    font-size: 5.2%P,
                    font-bold,
                    font-family: themeTitleFont,
                    color: documentTextPrimary
                )
                rectangle(position: (6, 16.4), size: (88, 0.15), origin: top-left, background-color: documentLine)
                slot
            }
        }

        @define body{
            group(
                position: (6, 19),
                size: (88, 73),
                origin: top-left,
                font-size: 3.4%P,
                color: documentTextPrimary
            ){
                slot
            }
        }

        @define body2a{
            col(
                position: (6, 19),
                size: (42, 73),
                origin: top-left,
                font-size: 3%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.9%P
                        margin: (1, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.9%P
                        margin: (1, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        @define body2b{
            col(
                position: (52, 19),
                size: (42, 73),
                origin: top-left,
                font-size: 3%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.9%P
                        margin: (1, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.9%P
                        margin: (1, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        @define body3a{
            col(
                position: (6, 19),
                size: (27, 73),
                origin: top-left,
                font-size: 2.6%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        @define body3b{
            col(
                position: (36.5, 19),
                size: (27, 73),
                origin: top-left,
                font-size: 2.6%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        @define body3c{
            col(
                position: (67, 19),
                size: (27, 73),
                origin: top-left,
                font-size: 2.6%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        header()
        slot
        footer()
    }
}

////////////////////
// CONCLUSION SLIDE
////////////////////

@define conclusion-slide(title:""){
    content-slide(title: either("${title}", "Conclusion"), section: "Closing remarks"){
        slot
    }
}

////////////////////
// THANK YOU SLIDE
////////////////////

@define thankyou-slide(title:"", subtitle:"Questions & discussion"){
    page{
        rectangle(background-color: documentBg)
        classic-art()

        rectangle(position: (7, 24), size: (2.2, 0.5), origin: left, background-color: documentColors[0])
        text(either("${documentChapter}", "Discussion"), position: (10.2, 24), origin: left, font-size: 2%P, font-bold, color: documentColors[0])
        text(either("${title}", "Thank you"), position: (7, 38), origin: left, font-size: 8.5%P, font-bold, font-family: themeTitleFont, color: documentTextPrimary)
        text("${subtitle}", position: (7, 50), origin: left, font-size: 3.2%P, color: documentTextSecondary)

        rectangle(position: (7, 62), size: (50, 0.15), origin: left, background-color: documentLine)
        text(either("${documentAuthor}", ""), position: (7, 70), origin: left, font-size: 3.2%P, font-bold, color: documentTextPrimary)
        text(either("${documentAuthorEmail}", ""), position: (7, 75.5), origin: left, font-size: 2.5%P, color: documentColors[0])

        text(either("${documentDate}", ""), position: (68, 91), origin: left, font-size: 2.2%P, color: themeOnInkMuted)
        text(either("${documentVersion}", ""), position: (96, 91), origin: right, font-size: 2.2%P, font-bold, color: themeOnInk)
        slot
    }
}
