////////////////////
// eniso theme — École Nationale d'Ingénieurs de Sousse (Université de Sousse)
// (single file to simplify AI edition)
//
// Academic and institutional: serif headings in ENISo navy, a crimson accent,
// the school logo in every header and a ruled footer. Same page grid and
// component API as classic:
//   margins x 6..94 · header 4..17 · body 19..91 · footer 95.5
////////////////////

import(
    "stdlib"
    "layout"
    "image"
    "text"
    "plantuml"
    "animated-gif"
    "svg"
    "shapes2d"
    "shapes3d"
    "plot2d"
    "scoreboard"
    "table"
    "presenters"
    "latex"
)

////////////////////
// VARS
////////////////////

documentTitle:="Document Title"
documentSubtitle:=""
documentSubsubtitle:=""
documentAuthor:="Author Name"
documentAuthorEmail:="author@eniso.u-sousse.tn"
documentAuthorAffiliation:="ENISo · Université de Sousse"
documentChapter:=""
documentDate:=""
documentVersion:="1.0"

themeShowPalette:=false
documentColorAccent:=0

// Institutional palette: ENISo navy first, crimson second
documentColors:=arrayLeftRotate([
    "#0b2a5b", // 0: ENISo navy (primary)
    "#9b1c2c", // 1: academic crimson
    "#0369a1", // 2: azure
    "#a16207", // 3: gold
    "#0f766e", // 4: teal
    "#4338ca", // 5: indigo
    "#15803d", // 6: forest
    "#7e22ce", // 7: purple
    "#be123c", // 8: rose
    "#c2410c", // 9: burnt orange
    "#334155", // 10: slate
    "#0f172a"  // 11: ink
], either(documentColorAccent, 0))

// Surfaces & text
documentBg:="#ffffff"
documentSurface:="#f7f9fc"
documentSurfaceAlt:="#eef2f8"
documentLine:="#d9e0ea"
documentTextPrimary:="#111827"
documentTextSecondary:="#3f4a5c"
documentTextMuted:="#667085"
documentPrimaryColor:=documentColors[0]

// Institution (cover header); override in main.ntx when needed
themeInstitution:="École Nationale d'Ingénieurs de Sousse"
themeUniversity:="Université de Sousse"
themeLogo:="images/eniso.png"

// Chrome
themeInk:="#0b2a5b"
themeOnInk:="#ffffff"
themeOnInkMuted:="#b9c6dc"
themeTitleFont:="Serif"
themeBodyFont:="SansSerif"
themeCardShadow:="#0b2a5b14"
themeArtA:="#ffffff14"
themeArtB:="#9b1c2c"
themeArtC:="#ffffff0d"
themeCodeBg:="#0f1b33"
themeCodeLine:="#24375c"
themeAccent:="#9b1c2c"

// PlantUML layout engine: ELK gives more balanced diagrams in narrow columns
plantumlLayout:="elk"

// Semantic colors (callouts)
semanticInfoColor:="#0369a1"
semanticInfoBg:="#f0f7fc"
semanticWarningColor:="#92400e"
semanticWarningBg:="#fdf7ec"
semanticErrorColor:="#9b1c2c"
semanticErrorBg:="#fbf1f2"
semanticSuccessColor:="#15803d"
semanticSuccessBg:="#f0f8f2"

////////////////////
// STYLES
////////////////////

styles{
    (*){
        font-size : 3.4%P
        font-family : themeBodyFont,
        color: documentTextPrimary
    }

    source{
        font-size : 2.3%P,
        font-family : "monospaced",
        source-primary-color: "#e8eaf2"
        source-keyword-color: "#8ab4ff"
        source-entity-color: "#7dd3fc"
        source-action-color: "#a5b4fc"
        source-annotation-color: "#fda4af"
        source-variable-color: "#f9a8d4"
        source-operator-color: "#e8eaf2"
        source-separator-color: "#9aa3b8"
        source-comments-color: "#7c859c"
        source-string-color: "#b5e08a"
        source-input-color: "#fde68a"
        source-path-color: "#7dd3fc"
        source-version-color: "#fbbf77"
        source-number-color: "#fbbf77"
        source-date-color: "#fbbf77"
        source-boolean-color: "#fbbf77"
        source-option-color: "#c4b5fd"
        source-title-color: "#e8eaf2"
        source-error-color: "#f87171"
        source-keyword-font-bold
        background-color: themeCodeBg
        color: "#e8eaf2"
        line-color: themeCodeLine
        draw-contour: true
        padding: (1%P, 0.6%P)
    }

    page{
        background-color: documentBg
    }

    text{
        text-wrap: wrap
        source-code-font-family: "monospaced"
        source-primary-color: "#14161c"
        source-keyword-color: "#3730a3"
        source-entity-color: "#4338ca"
        source-action-color: "#0e7490"
        source-annotation-color: "#be123c"
        source-variable-color: "#9f1239"
        source-operator-color: "#14161c"
        source-separator-color: "#6b7080"
        source-comments-color: "#6b7080"
        source-string-color: "#166534"
        source-input-color: "#a16207"
        source-path-color: "#0e7490"
        source-version-color: "#b45309"
        source-number-color: "#b45309"
        source-date-color: "#b45309"
        source-boolean-color: "#6d28d9"
        source-option-color: "#4338ca"
        source-title-color: "#14161c"
        source-error-color: "#b91c1c"
    }
    ellipse{
        at: center,
    }
    arc{
        at: center,
    }

    @ul-item{
        margin : (1.2, 0)
        at: left,
        font-size: 3.2%P
        text-wrap: wrap
    }
    @ul-item-2{
        font-size: 2.8%P
        color: documentTextSecondary
    }
    @ul-bullet{
        background-color: documentColors[0]
        at: left,
        size: 1.1%P
    }
    @ul-bullet-2{
        background-color: documentTextMuted
        size: 0.9%P
    }
    @ol-bullet{
        color: documentColors[0]
        at: center,
        font-bold
    }
    @ol-item{
        at: left,
        margin: (1.2, 0)
        font-size: 3.2%P
        text-wrap: wrap
    }
    @compact{
        font-size: 2%P
    }
    @compact-list{
        font-size: 2%P
    }
    @large{
        font-size: 3.4%P
    }
    @lead{
        font-size: 3.2%P
        color: documentTextSecondary
    }
    @muted{
        color: documentTextMuted
    }
    @accent{
        color: documentColors[0]
        font-bold
    }
    @image-fig{
        margin: 2
    }
    @image-fig-title{
        at: top
        font-size: 2%P
        font-bold,
        color: documentTextPrimary
    }
    @image-fig-legend{
        at: bottom
        font-size: 1.6%P
        color: documentTextMuted
    }
    grid{
        line-color: documentLine
    }
    eq{
        color: documentTextPrimary
    }
    ntf{
        color: documentTextPrimary
    }

    table{
        font-size: 2.4%P
        color: documentTextPrimary
        background-color: documentSurface
        draw-grid
        line-color: documentLine
        padding: (0.8%P, 0.4%P)
    }
    table-header{
        font-size: 2.4%P
        font-bold
        color: "#ffffff"
        background-color: documentColors[0]
    }
    table-footer{
        font-size: 2.2%P
        font-bold
        color: documentTextSecondary
        background-color: documentSurfaceAlt
    }
    table-row(row: even): {
        background-color: documentBg
    }
    table-cell{
        padding: (0.8%P, 0.4%P)
    }

    @table-striped{
        background-color: documentSurface
        row(row: even){
            background-color: documentSurfaceAlt
        }
        table-header{
            font-bold
            color: "#ffffff"
            background-color: documentColors[0]
        }
        cell{ padding: (0.8%P, 0.4%P) }
    }

    @table-bordered{
        background-color: documentSurface
        draw-grid
        line-color: documentLine
        row{
            background-color: documentSurface
            color: documentTextPrimary
        }
        table-header{
            font-bold
            color: documentTextPrimary
            background-color: documentSurfaceAlt
        }
        cell{ padding: (0.8%P, 0.4%P) }
    }
}

////////////////////
// COMPONENTS
////////////////////

@define image-fig(src, title:"", legend:"", at:center, size:30){
    @(img) group(at: at, size: size){
        rectangle(background-color: documentSurface, line-color: documentLine, draw-contour, size: 98, round-corner: 2)
        @(image-fig) image(src, size: (92, 80), at: center, preserve-aspect-ratio)
        @(image-fig-title) text("${title}")
        @(image-fig-legend) text("${legend}")
    }
}

// Card: white surface, hairline border, faint shadow and an accent tab on top.
@define card(accentColor: ""){
    group(margin: 1, row-weight: 70){
        rectangle(
            background-color: documentSurface,
            line-color: documentLine,
            draw-contour: true,
            round-corner: 1,
            shadow: {distance: (0, 1), radius: 3, color: themeCardShadow}
        )
        rectangle(background-color: either(accentColor, documentColors[0]), position: (4, 0), origin: top-left, size: (16, 0.45%P))
        @define kicker(text, color: ""){
            group(position: (4, 5), size: (92, 7), origin: top-left){
                text("${text}", position: (0, 50), origin: left, font-size: 1.9%P, font-bold, color: either(color, either(accentColor, documentColors[0])))
            }
        }
        styles{
            unordered-list{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            ul{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            ordered-list{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            ol{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            column{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            col{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
            }
            source{
                position: (4, 15)
                size: (92, 81)
                origin: top-left
                font-size: 2.1%P
            }
            @ul-item{
                font-size: 2.5%P
                margin: (0.8, 0)
                text-wrap: wrap
            }
            @ol-item{
                font-size: 2.5%P
                margin: (0.8, 0)
                text-wrap: wrap
            }
            @ul-bullet{
                size: 0.9%P
                background-color: either(accentColor, documentColors[0])
            }
        }
        slot
    }
}

// Small uppercase label preceded by an accent dash.
@define kicker(text, color: ""){
    group(size: (100, 6)){
        rectangle(position: (0, 50), size: (1.4%P, 0.3%P), origin: left, background-color: either(color, documentColors[0]))
        text("${text}", position: (2.2%P, 50), origin: left, font-size: 2%P, font-bold, color: either(color, documentColors[0]))
    }
}

@define divider(width: 40, thickness: 0.3){
    rectangle(size: (width, thickness), background-color: documentColors[0])
}

@define stat(value, label, accentColor: ""){
    group(margin: 1){
        text("${value}", position: (50, 40), origin: center, font-size: 7%P, font-bold, font-family: themeTitleFont, color: either(accentColor, documentColors[0]))
        rectangle(position: (50, 60), origin: center, size: (12, 0.25%P), background-color: documentLine)
        text("${label}", position: (50, 72), origin: center, font-size: 2.2%P, color: documentTextSecondary)
    }
}

@define quote(author: ""){
    group(margin: 3){
        text("“", position: (0, 0), origin: top-left, font-size: 7%P, font-family: "Serif", font-bold, color: documentColors[0])
        group(position: (2, 16), size: (96, 78)){
            slot
            text(either("${author}", ""), position: (0, 94), font-size: 1.8%P, color: documentTextSecondary, font-bold)
        }
    }
}

@define panel(background: "", title:"", accentColor){
    group(margin: 2){
        rectangle(
            background-color: either(background, documentSurface),
            line-color: documentLine,
            draw-contour: true,
            round-corner: 1,
            shadow: {distance: (0, 1), radius: 3, color: themeCardShadow}
        )
        group(position: (4, 8), size: (92, 88)){
            text(
                either("${title}", ""),
                font-size: 2.8%P,
                font-bold,
                position: (0, 0),
                origin: top-left,
                color: either(accentColor, documentColors[0])
            )
            group(position: (0, 14), size: (100, 86)){
                slot
            }
        }
    }
}

@define callout(title: "", accentColor, bgColor){
    group(margin: 1, row-weight: 30){
        rectangle(background-color: bgColor, line-color: documentLine, draw-contour: true, round-corner: 2)
        rectangle(background-color: accentColor, position: (0, 50), origin: left, size: (0.45%P, 84))
        group(position: (5, 8), size: (90, 86), origin: top-left){
            text(either("${title}", ""), position: (0, 0), origin: top-left, font-bold, color: accentColor, font-size: 2.4%P)
            group(position: (0, 20), size: (100, 80), origin: top-left){
                styles{
                    (*){
                        font-size: 2.3%P
                        color: documentTextPrimary
                    }
                }
                slot
            }
        }
    }
}

@define hint-info(title){
    callout(title: either("${title}", "Information"), accentColor: semanticInfoColor, bgColor: semanticInfoBg){
        slot
    }
}

@define hint-warning(title){
    callout(title: either("${title}", "Warning"), accentColor: semanticWarningColor, bgColor: semanticWarningBg){
        slot
    }
}

@define hint-error(title){
    callout(title: either("${title}", "Important"), accentColor: semanticErrorColor, bgColor: semanticErrorBg){
        slot
    }
}

@define hint-success(title){
    callout(title: either("${title}", "Note"), accentColor: semanticSuccessColor, bgColor: semanticSuccessBg){
        slot
    }
}

@define definition(title){
    callout(title: either("${title}", "Définition"), accentColor: semanticInfoColor, bgColor: semanticInfoBg){
        slot
    }
}

@define theorem(title){
    callout(title: either("${title}", "Théorème"), accentColor: documentColors[0], bgColor: documentSurfaceAlt){
        slot
    }
}

@define example(title){
    callout(title: either("${title}", "Exemple"), accentColor: semanticSuccessColor, bgColor: semanticSuccessBg){
        slot
    }
}

@define remark(title){
    callout(title: either("${title}", "Remarque"), accentColor: semanticWarningColor, bgColor: semanticWarningBg){
        slot
    }
}

// Footer: hairline, document title, institution and date.
@define footer(){
    rectangle(position: (6, 93.2), size: (88, 0.12), origin: top-left, background-color: documentLine)
    text("${documentTitle}", position: (6, 95.8), origin: left, font-size: 1.7%P, font-bold, color: documentColors[0])
    text(either("${documentAuthorAffiliation}", ""), position: (50, 95.8), origin: center, font-size: 1.7%P, color: documentTextMuted)
    text(either("${documentDate}", ""), position: (94, 95.8), origin: right, font-size: 1.7%P, color: documentTextMuted)
}

// Institutional frame: navy edge band with a crimson filet.
@define eniso-frame(){
    rectangle(position: (96.2, 0), size: (3.8, 100), origin: top-left, background-color: themeInk)
    rectangle(position: (95.7, 0), size: (0.5, 100), origin: top-left, background-color: themeAccent)
}

// Institution header used by the cover and closing slides.
@define eniso-masthead(){
    image(themeLogo, position: (7, 10.5), origin: left, size: (6.5, 11), preserve-aspect-ratio)
    text(themeInstitution, position: (14.5, 8.8), origin: left, font-size: 2.4%P, font-bold, font-family: themeTitleFont, color: documentColors[0])
    text(themeUniversity, position: (14.5, 13), origin: left, font-size: 1.9%P, color: documentTextSecondary)
    rectangle(position: (7, 19), size: (85, 0.2), origin: top-left, background-color: documentColors[0])
}

////////////////////
// COVER SLIDE
////////////////////

@define cover-slide(){
    page{
        rectangle(background-color: documentBg)
        eniso-frame()
        eniso-masthead()

        text(either("${documentChapter}", ""), position: (7, 30), origin: left, font-size: 2.2%P, font-bold, color: themeAccent)
        text("${documentTitle}", position: (7, 41), origin: left, font-size: 8%P, font-bold, font-family: themeTitleFont, color: documentColors[0])
        text(either("${documentSubtitle}", ""), position: (7, 52.5), origin: left, font-size: 3.4%P, color: documentTextSecondary)
        text(either("${documentSubsubtitle}", ""), position: (7, 58.5), origin: left, font-size: 2.4%P, color: documentTextMuted)
        rectangle(position: (7, 66), size: (6, 0.5), origin: left, background-color: themeAccent)

        text(either("${documentAuthor}", ""), position: (7, 74), origin: left, font-size: 3%P, font-bold, color: documentTextPrimary)
        text(either("${documentAuthorAffiliation}", ""), position: (7, 79), origin: left, font-size: 2.2%P, color: documentTextSecondary)
        text(either("${documentAuthorEmail}", ""), position: (7, 83.5), origin: left, font-size: 2.2%P, color: documentColors[2])

        text(either("${documentDate}", ""), position: (92, 79), origin: right, font-size: 2.2%P, color: documentTextMuted)
        text(either("${documentVersion}", ""), position: (92, 83.5), origin: right, font-size: 2.2%P, font-bold, color: documentColors[0])
        slot
    }
}

////////////////////
// SECTION SLIDE (chapter openers)
////////////////////

@define section-slide(title, number:"", subtitle:""){
    page{
        rectangle(background-color: themeInk)
        rectangle(position: (95.7, 0), size: (0.5, 100), origin: top-left, background-color: themeAccent)
        text("${number}", position: (8, 36), origin: left, font-size: 11%P, font-bold, font-family: themeTitleFont, color: themeOnInkMuted)
        rectangle(position: (8, 50), size: (6, 0.5), origin: left, background-color: themeAccent)
        text("${title}", position: (8, 60), origin: left, font-size: 6%P, font-bold, font-family: themeTitleFont, color: themeOnInk)
        text("${subtitle}", position: (8, 69), origin: left, font-size: 2.6%P, color: themeOnInkMuted)
        text("${documentTitle}", position: (8, 95.6), origin: left, font-size: 1.7%P, color: themeOnInkMuted)
        slot
    }
}

////////////////////
// AGENDA SLIDE
////////////////////
@define agenda-slide(title:""){
    content-slide(title: either("${title}", "Plan")){
        styles{
            @ul-item{
                margin: (2.4, 0)
                font-size: 3.8%P
                text-wrap: wrap
            }
            @ol-item{
                margin: (2.4, 0)
                font-size: 3.8%P
                text-wrap: wrap
            }
            @ol-bullet{
                font-size: 3.8%P
                color: documentColors[0]
            }
        }
        slot
    }
}

////////////////////
// CONTENT SLIDE
////////////////////

@default-body(body, body2a, body2b, body3a, body3b, body3c)
@define content-slide(title, section:""){
    page{
        rectangle(background-color: documentBg)
        // institutional top band and logo
        rectangle(position: (0, 0), size: (100, 0.9), origin: top-left, background-color: themeInk)
        image(themeLogo, position: (94, 9.6), origin: right, size: (4.6, 8.4), preserve-aspect-ratio)

        @define header{
            group(position: (0, 0), size: (100, 100), origin: top-left){
                text(
                    either("${section}", either("${documentChapter}", "${documentTitle}")),
                    position: (6, 5.6),
                    origin: left,
                    font-size: 1.9%P,
                    font-bold,
                    color: themeAccent
                )
                text(
                    "${title}",
                    position: (6, 11),
                    origin: left,
                    font-size: 5%P,
                    font-bold,
                    font-family: themeTitleFont,
                    color: documentColors[0]
                )
                rectangle(position: (6, 16.2), size: (88, 0.22), origin: top-left, background-color: documentColors[0])
                rectangle(position: (6, 16.85), size: (88, 0.08), origin: top-left, background-color: documentLine)
                slot
            }
        }

        @define body{
            group(
                position: (6, 19),
                size: (88, 73),
                origin: top-left,
                font-size: 3.4%P,
                color: documentTextPrimary
            ){
                slot
            }
        }

        @define body2a{
            col(
                position: (6, 19),
                size: (42, 73),
                origin: top-left,
                font-size: 3%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.9%P
                        margin: (1, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.9%P
                        margin: (1, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        @define body2b{
            col(
                position: (52, 19),
                size: (42, 73),
                origin: top-left,
                font-size: 3%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.9%P
                        margin: (1, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.9%P
                        margin: (1, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        @define body3a{
            col(
                position: (6, 19),
                size: (27, 73),
                origin: top-left,
                font-size: 2.6%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        @define body3b{
            col(
                position: (36.5, 19),
                size: (27, 73),
                origin: top-left,
                font-size: 2.6%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        @define body3c{
            col(
                position: (67, 19),
                size: (27, 73),
                origin: top-left,
                font-size: 2.6%P,
                color: documentTextPrimary
            ){
                styles{
                    @ul-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                    @ol-item{
                        font-size: 2.5%P
                        margin: (0.9, 0)
                        text-wrap: wrap
                    }
                }
                slot
            }
        }

        header()
        slot
        footer()
    }
}

////////////////////
// CONCLUSION SLIDE
////////////////////

@define conclusion-slide(title:""){
    content-slide(title: either("${title}", "Conclusion"), section: "Closing remarks"){
        slot
    }
}

////////////////////
// THANK YOU SLIDE
////////////////////

@define thankyou-slide(title:"", subtitle:"Questions & discussion", author:""){
    page{
        rectangle(background-color: documentBg)
        eniso-frame()
        eniso-masthead()

        text(either("${title}", "Merci pour votre attention"), position: (7, 40), origin: left, font-size: 6.5%P, font-bold, font-family: themeTitleFont, color: documentColors[0])
        text("${subtitle}", position: (7, 51), origin: left, font-size: 3.2%P, color: documentTextSecondary)
        rectangle(position: (7, 60), size: (6, 0.5), origin: left, background-color: themeAccent)

        text(either("${author}", either("${documentAuthor}", "")), position: (7, 70), origin: left, font-size: 3%P, font-bold, color: documentTextPrimary)
        text(either("${documentAuthorEmail}", ""), position: (7, 75.5), origin: left, font-size: 2.2%P, color: documentColors[2])

        text(either("${documentDate}", ""), position: (92, 75.5), origin: right, font-size: 2.2%P, color: documentTextMuted)
        slot
    }
}
